# Copy to .env and fill in only what you use.
# AnywhereBot never hardcodes secrets. Ollama needs no key.
# provider: auto prefers Ollama, then OpenRouter, then Groq, then Gemini.

# OpenRouter — https://openrouter.ai/keys  (openrouter/free or a :free slug)
# OPENROUTER_API_KEY=

# Groq — https://console.groq.com (free tier; openai/gpt-oss-20b)
# GROQ_API_KEY=

# Gemini — https://aistudio.google.com (free tier; gemini-3.6-flash)
# GEMINI_API_KEY=

# Generic OpenAI-compatible server (vLLM, llama.cpp, LM Studio)
# OPENAI_API_KEY=

# Optional overrides (Docker / one-off). Empty means "use llm.yaml".
# ANYWHEREBOT_PROVIDER=
# ANYWHEREBOT_MODEL=
# ANYWHEREBOT_BASE_URL=
# ANYWHEREBOT_API_KEY_ENV=
